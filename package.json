{
  "name": "mezcalito",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Mezcalito Bar & Grill — Jamaican-Mexican fusion in Bávaro. Website, online ordering, reservations.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply mezcalito --local",
    "db:seed:local": "wrangler d1 execute mezcalito --local --file=seed/seed.sql",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/react": "^7.1.0",
    "astro": "^7.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
