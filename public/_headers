# The service worker and manifest must be re-checked on every visit, or a
# fixed bug could live on in visitors' browsers.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: public, max-age=3600
# Mezcalito's own photos, logo and promo video. They keep their names when
# replaced, so they are cached for a week rather than forever.
/img/*
  Cache-Control: public, max-age=604800
/video/*
  Cache-Control: public, max-age=604800
