{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["./worker-configuration.d.ts", "@astrojs/cloudflare/types.d.ts"],
    "noUncheckedIndexedAccess": true
  }
}
