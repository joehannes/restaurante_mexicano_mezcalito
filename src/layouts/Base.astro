---
/**
 * Every page's frame: language, alternates, and the active season's skin
 * injected as CSS variables before first paint.
 */
import '../styles/global.css';
// The poster face and the body face, preloaded so headlines do not re-wrap when they arrive.
import anton from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import dmSans from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import type { Locale } from '../domain/types';
import { LOCALES } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path after the locale, e.g. `/menu`. */
  path?: string;
  /** CSS custom properties from the active season. */
  tokens?: Record<string, string>;
  /** Share image path; the site-wide poster by default. */
  image?: string;
}

const { locale, title, description, path = '/', tokens = {}, image = '/og.jpg' } = Astro.props;
const site = Astro.url.origin;
const suffix = path === '/' ? '/' : path;
// Only well-formed custom properties with plain colour values reach the page.
const skin = Object.entries(tokens)
  .filter(([name, value]) => /^--c-[a-z]+$/.test(name) && /^#[0-9a-fA-F]{3,8}$/.test(value))
  .map(([name, value]) => `${name}:${value}`)
  .join(';');
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}/${locale}${suffix}`} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={`${site}/${l}${suffix}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${site}/en${suffix}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(image, site).href} />
    <meta property="og:url" content={`${site}/${locale}${suffix}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#141210" />
    <link rel="preload" href={anton} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSans} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {skin && <style is:inline set:html={`:root{${skin}}`} />}
    <script is:inline>document.documentElement.classList.add('js')</script>
    <slot name="head" />
  </head>
  <body class="min-h-dvh antialiased">
    <slot />
    <script is:inline>
      // The page's motion, in one small script: reveal things as they scroll in,
      // play the silent video loops only while they are on screen (never for
      // reduced motion or Data Saver), and the hero logo's airhorn.
      (() => {
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const thrifty = navigator.connection?.saveData;
        const seen = new IntersectionObserver(
          (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('is-in'), seen.unobserve(e.target))),
          { rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('.reveal').forEach((el) => seen.observe(el));

        const loops = new IntersectionObserver((entries) =>
          entries.forEach(({ target: v, isIntersecting }) => {
            if (isIntersecting) {
              if (!v.src) v.src = v.dataset.loop;
              v.play().catch(() => {});
            } else v.pause();
          }),
        );
        // Without motion a loop becomes an ordinary video to play by hand; a
        // purely decorative one just keeps its poster.
        document.querySelectorAll('video[data-loop]').forEach((v) => {
          if (!still && !thrifty) loops.observe(v);
          else if (!v.hasAttribute('data-decor')) (v.controls = true), (v.src = v.dataset.loop);
        });

        // A dancehall airhorn, synthesised: three blasts, the last one long.
        let audio;
        document.querySelectorAll('[data-airhorn]').forEach((el) =>
          el.addEventListener('click', () => {
            audio ??= new AudioContext();
            const now = audio.currentTime;
            [0, 0.22, 0.44].forEach((at, i) => {
              const len = i === 2 ? 0.9 : 0.16;
              const gain = audio.createGain();
              gain.gain.setValueAtTime(0, now + at);
              gain.gain.linearRampToValueAtTime(0.18, now + at + 0.02);
              gain.gain.setValueAtTime(0.18, now + at + len - 0.05);
              gain.gain.linearRampToValueAtTime(0, now + at + len);
              gain.connect(audio.destination);
              [440, 554, 660].forEach((f) => {
                const osc = audio.createOscillator();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(f * 0.94, now + at);
                osc.frequency.linearRampToValueAtTime(f, now + at + 0.06);
                osc.connect(gain);
                osc.start(now + at);
                osc.stop(now + at + len);
              });
            });
            el.animate?.([{ transform: 'rotate(0) scale(1)' }, { transform: 'rotate(-8deg) scale(1.08)' }, { transform: 'rotate(6deg) scale(1.04)' }, { transform: 'none' }], { duration: 700 });
          }),
        );
      })();
    </script>
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ locale }}>
        // Installable, and the menu readable offline (see public/sw.js).
        if ('serviceWorker' in navigator) {
          addEventListener('load', () =>
            navigator.serviceWorker.register('/sw.js').then(() => navigator.serviceWorker.ready).then((r) => r.active?.postMessage({ warm: locale })),
          );
        }
      </script>
    )}
  </body>
</html>
