---
/**
 * A public page: the season-skinned frame plus the fascia header, the phone
 * thumb bar and the footer.
 */
import Base from './Base.astro';
import BottomBar from '../components/BottomBar.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TableBar from '../components/TableBar.astro';
import type { SeasonRecord } from '../server/content';
import type { PageContext } from '../server/page';
import { t } from '../i18n/ui';

interface Props {
  ctx: PageContext;
  title: string;
  description: string;
  /** Path after the locale, e.g. `/menu`. */
  path: string;
  /** Wear this season's skin instead of the one that is live (a season's own page). */
  season?: SeasonRecord;
}
const { ctx, title, description, path } = Astro.props;
const season = Astro.props.season ?? ctx.season;
if (ctx.preview) Astro.response.headers.set('cache-control', 'no-store');
---
<Base locale={ctx.locale} title={title} description={description} path={path} tokens={season?.tokens} image={season?.ogImage ?? undefined}>
  <slot name="head" slot="head" />
  {ctx.preview && <p class="bg-sunset px-4 py-2 text-center text-sm font-bold text-cream">{t(ctx.locale, 'season.preview')}</p>}
  <Header locale={ctx.locale} path={path} />
  <TableBar locale={ctx.locale} />
  <main id="main">
    <slot />
  </main>
  <Footer ctx={ctx} />
  <BottomBar locale={ctx.locale} path={path} />
</Base>
