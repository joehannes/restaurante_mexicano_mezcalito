---
import { env } from 'cloudflare:workers';
import Site from '../../layouts/Site.astro';
import Poster from '../../components/Poster.astro';
import Selector from '../../islands/Selector';
import { dictionary, t } from '../../i18n/ui';
import { loadMenu } from '../../server/menu';
import { href, notFound, pageContext } from '../../server/page';

const ctx = await pageContext(Astro.params.lang);
if (!ctx) return notFound();
const { locale, site } = ctx;
const menu = (await loadMenu(env.DB)).filter((i) => !i.hidden);
---
<Site ctx={ctx} path="/selector" title={`${t(locale, 'selector.title')} — Mezcalito`} description={t(locale, 'selector.intro')}>
  <div class="mx-auto max-w-3xl px-4 pt-8 pb-6">
    <h1 class="font-display text-5xl uppercase md:text-6xl">{t(locale, 'selector.title')}</h1>
    <p class="mt-2 text-lg">{t(locale, 'selector.intro')}</p>
    <Poster name="selector" alt={t(locale, 'art.selector')} tilt={-1.2} sticker="chili" class="mt-6" />
  </div>
  <Selector
    client:load
    locale={locale}
    dict={dictionary(locale)}
    menu={menu}
    pricing={site.pricing}
    menuHref={href(locale, '/menu')}
    checkoutHref={href(locale, '/checkout')}
    reserveHref={href(locale, '/reserve')}
    radioHref={href(locale, '/radio')}
  />
</Site>
