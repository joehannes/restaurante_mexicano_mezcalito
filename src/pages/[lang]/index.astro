---
import { env } from 'cloudflare:workers';
import Site from '../../layouts/Site.astro';
import Hero from '../../components/Hero.astro';
import FlyerCard from '../../components/FlyerCard.astro';
import DishSingle from '../../components/DishSingle.astro';
import JsonLd from '../../components/JsonLd.astro';
import Reorder from '../../components/Reorder.astro';
import PolaroidWall from '../../components/PolaroidWall.astro';
import EventBanner from '../../components/EventBanner.astro';
import { activeSpecials, parseClock, specialsOn, localNow } from '../../domain/schedule';
import { localized } from '../../domain/types';
import { formatClock } from '../../lib/format';
import { restaurantJsonLd } from '../../lib/seo';
import { t } from '../../i18n/ui';
import { currentEvent, loadEvents } from '../../server/events';
import { loadGallery } from '../../server/gallery';
import { loadMenu } from '../../server/menu';
import { href, notFound, pageContext } from '../../server/page';

const ctx = await pageContext(Astro.params.lang, Astro.request);
if (!ctx) return notFound();
const { locale, site } = ctx;

const [menu, polaroids, events] = await Promise.all([loadMenu(env.DB), loadGallery(env.DB, { home: true }), loadEvents(env.DB, { today: ctx.today })]);
const featured = currentEvent(events, ctx.today);
const signatures = menu.filter((i) => i.tags.includes('signature') && !i.hidden).slice(0, 6);

// An offer that runs all day, every day is on the line-up, not news for tonight's strip.
const news = (s: (typeof ctx.specials)[number]) => s.days.length > 0 || s.start > '08:00' || s.end !== '24:00';
const live = activeSpecials(ctx.now, ctx.specials, ctx.tz).filter(news);
const minutes = localNow(ctx.now, ctx.tz).minutes;
const later = specialsOn(ctx.today, ctx.specials).filter((s) => news(s) && !live.includes(s) && parseClock(s.start) > minutes);
const lineup = ctx.specials.filter((s) => s.active);
const maps = `https://www.google.com/maps/search/?api=1&query=${site.address.lat},${site.address.lng}`;
// The ticker under the hero: the slogans, then every night of the week by name.
const ticker = [t(locale, 'brand.slogan'), t(locale, 'home.marqueeMega'), ...lineup.map((s) => localized(s.title, locale)), t(locale, 'home.marqueeTaco')];
---
<Site
  ctx={ctx}
  path="/"
  title={`Mezcalito Bar & Grill — ${t(locale, 'brand.tagline')} · Bávaro, Punta Cana`}
  description={`${t(locale, 'brand.tagline')} ${t(locale, 'brand.place')}. ${t(locale, 'home.howItWorks')}`}
>
  <JsonLd slot="head" data={restaurantJsonLd(site, Astro.url.origin, locale)} />
  <Hero ctx={ctx} />
  <div class="overflow-hidden border-y-4 border-ink bg-hibiscus py-2 text-cream" aria-hidden="true">
    <div class="marquee font-display text-xl tracking-wide uppercase md:text-2xl">
      {[0, 1].map(() => (
        <p class="flex shrink-0 items-center">
          {ticker.map((word, i) => (
            <>
              <span class="px-4">{word}</span>
              <span class={['text-gold', 'text-jungle', 'text-lagoon', 'text-ink'][i % 4]}>✦</span>
            </>
          ))}
        </p>
      ))}
    </div>
  </div>
  <Reorder locale={locale} />
  {featured && <EventBanner event={featured} ctx={ctx} />}

  {(live.length > 0 || later.length > 0) && (
    <section class="bg-gold" aria-labelledby="now">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 font-semibold">
        <h2 id="now" class="flex items-center gap-2 font-display text-xl uppercase">
          {live.length > 0 && <span class="eq text-hibiscus" aria-hidden="true"><span></span><span></span><span></span><span></span></span>}
          {t(locale, 'nav.tonight')}
        </h2>
        {live.map((s) => <span>● {localized(s.title, locale)}</span>)}
        {later.map((s) => <span class="opacity-80">{formatClock(s.start, locale)} · {localized(s.title, locale)}</span>)}
        <a href={href(locale, '/tonight')} class="ml-auto underline">{t(locale, 'home.lineup')} →</a>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-4 pt-14" aria-labelledby="signatures">
    <h2 id="signatures" class="reveal font-display text-4xl uppercase md:text-5xl">{t(locale, 'home.signatures')}</h2>
    <p class="reveal mt-2 max-w-2xl" style="--d:80ms">{t(locale, 'home.signaturesSub')}</p>
    <div class="mt-8 grid grid-cols-2 gap-x-5 gap-y-8 md:grid-cols-3">
      {signatures.map((item, i) => (
        <div class="reveal reveal-pop" style={`--d:${(i % 3) * 90}ms; --tilt:${[-1.5, 1, -0.5][i % 3]}deg`}>
          <DishSingle item={item} locale={locale} side={`${i % 2 ? 'B' : 'A'}${Math.floor(i / 2) + 1}`} />
        </div>
      ))}
    </div>
    <p class="mt-8"><a href={href(locale, '/menu')} class="font-bold underline">{t(locale, 'home.fullMenu')} →</a></p>
    <div class="reveal halftone mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 rounded-2xl bg-mezcal p-5 text-cream shadow-[5px_5px_0_var(--c-ink)]">
      <p class="font-display text-2xl uppercase">{t(locale, 'home.unsure')}</p>
      <a href={href(locale, '/selector')} class="jiggle shine rounded-full bg-gold px-5 py-2 font-bold text-ink">{t(locale, 'selector.title')} →</a>
      <a href={href(locale, '/radio')} class="group inline-flex items-center gap-2 font-semibold underline">
        <span class="inline-block group-hover:animate-[jiggle_420ms_ease-in-out]">📻</span>
        {t(locale, 'radio.title')}
        <span class="eq text-gold" aria-hidden="true"><span></span><span></span><span></span></span>
      </a>
    </div>
  </section>

  <section class="mt-16 bg-ink py-14 text-cream" aria-labelledby="lineup">
    <div class="mx-auto max-w-6xl px-4">
      <h2 id="lineup" class="reveal font-display text-4xl text-gold uppercase md:text-5xl">{t(locale, 'home.lineup')}</h2>
      <p class="reveal mt-2" style="--d:80ms">{t(locale, 'home.lineupSub')}</p>
    </div>
    <div class="mx-auto mt-8 flex max-w-6xl snap-x snap-mandatory gap-6 overflow-x-auto px-4 pb-6 md:grid md:grid-cols-3 md:overflow-visible">
      {lineup.map((s, i) => (
        <div class="reveal reveal-pop w-[78%] shrink-0 snap-center pt-3 md:w-auto" style={`--d:${(i % 3) * 110}ms`}>
          <FlyerCard special={s} locale={locale} index={i} live={live.includes(s)} />
        </div>
      ))}
    </div>
  </section>

  <section class="overflow-hidden pt-14" aria-labelledby="vibe">
    <div class="mx-auto max-w-6xl px-4">
      <h2 id="vibe" class="reveal flex flex-wrap items-center gap-3 font-display text-4xl uppercase md:text-5xl">
        {t(locale, 'home.vibe')}
        <span class="eq text-hibiscus" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
      </h2>
      <p class="reveal mt-2 max-w-2xl" style="--d:80ms">{t(locale, 'home.vibeSub')}</p>
      <div class="mt-8 flex items-stretch gap-3 md:gap-5">
        <div class="cabinet hidden md:flex" aria-hidden="true"><span></span><span></span></div>
        <figure class="reveal relative flex-1 overflow-hidden rounded-2xl border-4 border-ink bg-ink shadow-[6px_6px_0_var(--c-hibiscus)]">
          <!-- Mezcalito's own footage, cut to a silent loop. Loads and plays only on screen. -->
          <video
            data-loop="/video/vibe.mp4"
            poster="/video/vibe-poster.webp"
            muted
            loop
            playsinline
            preload="none"
            width="854"
            height="456"
            class="aspect-[854/456] w-full object-cover"
            aria-label={t(locale, 'home.vibeSub')}
          ></video>
          <span class="rec absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-ink/70 px-2.5 py-1 text-xs font-bold tracking-widest text-cream" aria-hidden="true">
            <span class="size-2 rounded-full bg-hibiscus"></span>REC
          </span>
          <figcaption class="sticker absolute bottom-3 left-3 bg-gold text-xs text-ink md:text-sm" style="--tilt:-3deg">🔇 {t(locale, 'home.vibeMuted')}</figcaption>
        </figure>
        <div class="cabinet hidden md:flex" aria-hidden="true"><span></span><span></span></div>
      </div>
    </div>
  </section>

  {polaroids.length > 0 && (
    <section class="halftone relative mt-16 overflow-hidden bg-mezcal py-14 text-cream" aria-labelledby="moments">
      <p class="pointer-events-none absolute -top-6 right-[-2rem] font-display text-[9rem] leading-none text-cream/5 uppercase select-none md:text-[14rem]" aria-hidden="true">One love</p>
      {[
        ['mic', 'top-24 right-3 w-16 md:right-10 md:w-24', 8, '0s'],
        ['margarita', 'bottom-24 left-2 w-14 md:left-8 md:w-20', -10, '-1.5s'],
        ['maracas', 'top-1/2 right-1 hidden w-20 md:block', 14, '-3s'],
        ['speaker', 'top-[46%] left-1 hidden w-16 lg:block', -6, '-2.2s'],
      ].map(([name, place, tilt, delay]) => (
        <img src={`/img/stickers/${name}.webp`} alt="" width="128" height="128" loading="lazy" class={`bob pointer-events-none absolute z-10 h-auto drop-shadow-[2px_3px_0_rgb(20_18_16/0.4)] ${place}`} style={`--tilt:${tilt}deg; --d:${delay}; --beat:6s`} />
      ))}
      <div class="relative mx-auto max-w-6xl px-4">
        <img
          src="/img/art/fiesta-panorama-960.webp"
          srcset="/img/art/fiesta-panorama-960.webp 900w, /img/art/fiesta-panorama.webp 1600w"
          sizes="(min-width: 1152px) 72rem, 100vw"
          alt={t(locale, 'art.fiesta')}
          width="1600"
          height="640"
          loading="lazy"
          decoding="async"
          class="reveal reveal-pop mb-10 w-full rounded-2xl border-4 border-ink object-cover shadow-[6px_6px_0_var(--c-gold)]"
          style="--tilt:-0.8deg"
        />
        <h2 id="moments" class="reveal flex flex-wrap items-center gap-3 font-display text-4xl text-gold uppercase md:text-5xl">
          {t(locale, 'gallery.homeTitle')}
          <span class="flash inline-block" aria-hidden="true">📸</span>
        </h2>
        <p class="reveal mt-2 max-w-2xl" style="--d:80ms">{t(locale, 'gallery.sub')}</p>
        <PolaroidWall items={polaroids.slice(0, 10)} locale={locale} />
        <p class="flex flex-wrap items-center gap-4">
          <a href={href(locale, '/gallery')} class="jiggle shine rounded-full bg-gold px-5 py-2 font-bold text-ink">{t(locale, 'gallery.more')} →</a>
          <span class="text-sm text-cream/80">{t(locale, 'gallery.hint')}</span>
        </p>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-4 pt-14" aria-labelledby="inside">
    <h2 id="inside" class="reveal font-display text-4xl uppercase md:text-5xl">{t(locale, 'home.inside')}</h2>
    <p class="reveal mt-2 max-w-2xl" style="--d:80ms">{t(locale, 'home.insideSub')}</p>
    <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3">
      {(
        [
          ['tacos-board', 'photo.tacos'],
          ['story', 'photo.bar'],
          ['facade', 'photo.facade'],
        ] as const
      ).map(([name, alt], i) => (
        <a
          href={href(locale, '/story')}
          class:list={['reveal reveal-pop overflow-hidden rounded-2xl border-4 border-ink shadow-[5px_5px_0_var(--c-ink)]', i === 0 && 'col-span-2 md:col-span-1']}
          style={`--d:${i * 100}ms; --tilt:${[-1, 1.2, -0.6][i]}deg`}
        >
          <img
            src={`/img/place/${name}-640.webp`}
            srcset={`/img/place/${name}-640.webp 640w, /img/place/${name}.webp 1280w`}
            sizes="(min-width: 768px) 33vw, 50vw"
            alt={t(locale, alt)}
            width="640"
            height="427"
            loading="lazy"
            decoding="async"
            class="aspect-[3/2] w-full object-cover transition-transform duration-500 hover:scale-105"
          />
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 pt-14 md:grid-cols-2">
    {site.reviewsSummary && (
      <div>
        <h2 class="font-display text-4xl uppercase">{t(locale, 'home.reviews')}</h2>
        <p class="mt-4 flex items-baseline gap-3">
          <span class="font-display text-7xl text-hibiscus">{site.reviewsSummary.rating.toFixed(1)}</span>
          <span class="stars reveal text-2xl text-gold" aria-hidden="true">{[0, 1, 2, 3, 4].map((i) => <span style={`--i:${i}`}>★</span>)}</span>
        </p>
        <p class="mt-1">
          {t(locale, 'home.rating', { rating: site.reviewsSummary.rating.toFixed(1), count: site.reviewsSummary.count.toLocaleString(locale) })}
        </p>
      </div>
    )}
    <div>
      <h2 class="flex items-center gap-2 font-display text-4xl uppercase">
        <span class="pin inline-block text-hibiscus" aria-hidden="true">📍</span>{t(locale, 'home.findUs')}
      </h2>
      <p class="mt-4 text-lg">{site.address.street}, {site.address.locality} · {localized(site.address.note, locale)}</p>
      <p class="mt-4 flex flex-wrap gap-3">
        <a href={maps} class="jiggle rounded-full bg-ink px-5 py-2 font-bold text-cream">{t(locale, 'find.directions')}</a>
        <a href={`https://wa.me/${site.contact.whatsapp.replace(/\D/g, '')}`} class="rounded-full bg-jungle px-5 py-2 font-bold text-cream">
          {t(locale, 'find.whatsapp')}
        </a>
      </p>
    </div>
  </section>
</Site>

<style>
  /* A speaker cabinet each side of the reel; the woofers pump. */
  .cabinet {
    width: 5.5rem;
    flex-direction: column;
    justify-content: space-around;
    align-items: center;
    border-radius: 1rem;
    border: 4px solid var(--c-ink);
    background:
      radial-gradient(color-mix(in srgb, var(--c-cream) 16%, transparent) 1px, transparent 1.5px) 0 0 / 6px 6px,
      #1d1a17;
    box-shadow: 6px 6px 0 var(--c-ink);
  }
  .cabinet > span {
    width: 4rem;
    aspect-ratio: 1;
    border-radius: 999px;
    background: radial-gradient(circle, #3a3530 0 18%, #0d0c0b 19% 30%, #2a2622 31% 62%, #0d0c0b 63%);
    box-shadow: inset 0 0 0 3px #4a443e;
    animation: woofer 0.48s ease-in-out infinite alternate;
  }
  .cabinet > span + span {
    animation-delay: -0.24s;
  }
  @keyframes woofer {
    to { transform: scale(1.07); }
  }
  .rec > span {
    animation: pulse-dot 1.2s steps(2, jump-none) infinite;
  }
  .stars > span {
    display: inline-block;
  }
  :global(html.js) .stars > span {
    opacity: 0.2;
    transform: scale(0.6);
    transition:
      opacity 300ms ease,
      transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(250ms + var(--i) * 120ms);
  }
  :global(html.js) .stars.is-in > span {
    opacity: 1;
    transform: none;
  }
  .pin {
    animation: pin 2.4s ease-in-out infinite;
  }
  /* The camera goes off now and then. */
  .flash {
    animation: flash 4.5s ease-in-out infinite;
  }
  @keyframes flash {
    0%, 86%, 100% { transform: none; filter: none; }
    88% { transform: scale(1.25) rotate(-8deg); filter: brightness(2.2) drop-shadow(0 0 10px #fff); }
    92% { transform: scale(1.05) rotate(3deg); filter: none; }
  }
  @keyframes pin {
    0%, 60%, 100% { transform: translateY(0); }
    70% { transform: translateY(-8px); }
    80% { transform: translateY(0); }
    88% { transform: translateY(-3px); }
  }
</style>
