---
import { env } from 'cloudflare:workers';
import Site from '../../layouts/Site.astro';
import MenuBoard from '../../islands/MenuBoard';
import JsonLd from '../../components/JsonLd.astro';
import { menuJsonLd } from '../../lib/seo';
import { dictionary, t } from '../../i18n/ui';
import { loadCategories, loadMenu } from '../../server/menu';
import { href, notFound, pageContext } from '../../server/page';

const ctx = await pageContext(Astro.params.lang);
if (!ctx) return notFound();
const { locale, site } = ctx;
const [menu, categories] = await Promise.all([loadMenu(env.DB), loadCategories(env.DB)]);
const visible = menu.filter((i) => !i.hidden);
---
<Site
  ctx={ctx}
  path="/menu"
  title={`${t(locale, 'menu.title')} — Mezcalito Bar & Grill, Bávaro`}
  description={`${t(locale, 'brand.tagline')}: oxtail, Rasta Pasta, quesabirria, jerk, tacos. ${t(locale, 'menu.intro')}`}
>
  <JsonLd slot="head" data={menuJsonLd(categories, visible, locale)} />
  <div class="mx-auto max-w-6xl px-4 pt-8">
    <h1 class="font-display text-5xl uppercase md:text-6xl">{t(locale, 'menu.title')}</h1>
    <p class="mt-2 max-w-2xl text-ink/80">{t(locale, 'menu.intro')}</p>
  </div>
  <MenuBoard
    client:load
    locale={locale}
    dict={dictionary(locale)}
    categories={categories}
    menu={visible}
    pricing={site.pricing}
    checkoutHref={href(locale, '/checkout')}
  />
</Site>
