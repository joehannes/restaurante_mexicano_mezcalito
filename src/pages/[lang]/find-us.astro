---
/**
 * Find us: address, the map, every day's hours, upcoming special hours, and
 * every way to reach the restaurant. Carries the Restaurant structured data,
 * which is what local search reads for name, address and phone.
 */
import Site from '../../layouts/Site.astro';
import JsonLd from '../../components/JsonLd.astro';
import OpenStatus from '../../components/OpenStatus.astro';
import { addDays } from '../../domain/schedule';
import { localized } from '../../domain/types';
import { formatClock, formatPhone } from '../../lib/format';
import { restaurantJsonLd } from '../../lib/seo';
import { longDate, t, weekdayName } from '../../i18n/ui';
import { notFound, pageContext } from '../../server/page';

const ctx = await pageContext(Astro.params.lang);
if (!ctx) return notFound();
const { locale, site, today } = ctx;

const { lat, lng } = site.address;
const maps = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
const osm = `https://www.openstreetmap.org/export/embed.html?bbox=${lng - 0.004},${lat - 0.0025},${lng + 0.004},${lat + 0.0025}&layer=mapnik&marker=${lat},${lng}`;
const wa = site.contact.whatsapp.replace(/\D/g, '');
const ranges = (list: { open: string; close: string }[]) =>
  list.length ? list.map((r) => `${formatClock(r.open, locale)}–${formatClock(r.close, locale)}`).join(', ') : t(locale, 'find.closed');
// Monday first, the way the week reads on a door sign.
const week = [1, 2, 3, 4, 5, 6, 0].map((day) => ({ day, name: weekdayName(`2026-10-${18 + day}`, locale), hours: site.hours[day] ?? [] }));
const todayWeekday = new Date(`${today}T12:00:00Z`).getUTCDay();
const closures = site.closures.filter((c) => c.date >= today && c.date <= addDays(today, 60));
---
<Site ctx={ctx} path="/find-us" title={`${t(locale, 'find.title')} — Mezcalito, Calle Pedro Mir, Bávaro`} description={t(locale, 'find.intro')}>
  <JsonLd slot="head" data={restaurantJsonLd(site, Astro.url.origin, locale)} />
  <div class="mx-auto max-w-6xl px-4 pt-8">
    <h1 class="font-display text-5xl uppercase md:text-6xl">{t(locale, 'find.title')}</h1>
    <p class="mt-2 max-w-2xl text-lg">{t(locale, 'find.intro')}</p>
    <OpenStatus ctx={ctx} class="mt-4 bg-ink text-cream" />
    <img
      src="/img/place/facade.webp"
      alt={t(locale, 'photo.facade')}
      width="680"
      height="510"
      loading="lazy"
      decoding="async"
      class="mt-6 aspect-[2/1] w-full rounded-2xl border-4 border-ink object-cover shadow-[6px_6px_0_var(--c-ink)] md:aspect-[3/1]"
    />
  </div>

  <div class="mx-auto mt-8 grid max-w-6xl gap-8 px-4 md:grid-cols-[3fr_2fr]">
    <div class="overflow-hidden rounded-2xl border-4 border-ink shadow-[6px_6px_0_var(--c-ink)]">
      <iframe
        title="Map: Mezcalito Bar & Grill, Calle Pedro Mir, Bávaro"
        src={osm}
        loading="lazy"
        class="block aspect-[4/3] w-full"
        referrerpolicy="no-referrer"
      ></iframe>
    </div>

    <div class="space-y-8">
      <section>
        <h2 class="font-display text-2xl uppercase">{t(locale, 'find.address')}</h2>
        <address class="mt-2 not-italic leading-relaxed">
          Mezcalito Bar &amp; Grill<br />
          {site.address.street}, {site.address.locality}<br />
          {site.address.region}, República Dominicana<br />
          <span class="text-ink/70">{localized(site.address.note, locale)}</span>
        </address>
        <a href={maps} class="mt-3 inline-block rounded-full bg-ink px-5 py-2 font-bold text-cream">{t(locale, 'find.directions')}</a>
      </section>

      <section>
        <h2 class="font-display text-2xl uppercase">{t(locale, 'find.contact')}</h2>
        <p class="mt-3 flex flex-wrap gap-3">
          <a class="rounded-full bg-jungle px-4 py-2 font-bold text-cream" href={`https://wa.me/${wa}`}>{t(locale, 'find.whatsapp')}</a>
          <a class="rounded-full border-2 border-ink px-4 py-2 font-bold" href={`tel:${site.contact.phone}`}>{t(locale, 'find.call')} {formatPhone(site.contact.phone)}</a>
        </p>
        <p class="mt-3">{t(locale, 'find.email')}: <a class="underline" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
      </section>
    </div>
  </div>

  <div class="mx-auto mt-12 grid max-w-6xl gap-8 px-4 md:grid-cols-2">
    <section>
      <h2 class="font-display text-3xl uppercase">{t(locale, 'find.hours')}</h2>
      <table class="mt-3 w-full">
        <tbody>
          {week.map((d) => (
            <tr class:list={['border-b border-ink/10', d.day === todayWeekday && 'font-bold']}>
              <th scope="row" class="py-2 text-left font-semibold capitalize">{d.name}</th>
              <td class="py-2 text-right">{ranges(d.hours)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {closures.length > 0 && (
        <>
          <h3 class="mt-6 font-bold">{t(locale, 'find.closures')}</h3>
          <ul class="mt-2">
            {closures.map((c) => (
              <li class="flex justify-between border-b border-ink/10 py-2">
                <span class="capitalize">{longDate(c.date, locale)}{c.reason && ` · ${c.reason}`}</span>
                <span>{ranges(c.ranges)}</span>
              </li>
            ))}
          </ul>
        </>
      )}
    </section>
    <section>
      <h2 class="font-display text-3xl uppercase">{t(locale, 'find.deliveryTitle')}</h2>
      <p class="mt-3">{t(locale, 'find.delivery')}</p>
      {site.social.ubereats && <a class="mt-3 inline-block underline" href={site.social.ubereats}>{t(locale, 'footer.delivery')} →</a>}
    </section>
  </div>
</Site>
