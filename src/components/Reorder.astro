---
/**
 * For a returning guest with an empty cart: their last order, back in the
 * cart in one tap. Anything since sold out is flagged at checkout.
 */
import type { Locale } from '../domain/types';
import { t } from '../i18n/ui';
import { href } from '../server/page';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---
<p data-reorder class="mx-auto hidden max-w-6xl px-4 pt-4">
  <a href={href(locale, '/checkout')} class="inline-flex items-center gap-2 rounded-full bg-jungle px-5 py-2 font-bold text-cream">↺ {t(locale, 'reorder.title')}</a>
</p>

<script>
  import { addToCart, getCart, lastOrder } from '../lib/cart';

  document.querySelectorAll<HTMLElement>('[data-reorder]').forEach((el) => {
    const lines = lastOrder();
    if (!lines.length || getCart().length) return;
    el.classList.remove('hidden');
    el.querySelector('a')?.addEventListener('click', () => lines.forEach((line) => addToCart(line)));
  });
</script>
