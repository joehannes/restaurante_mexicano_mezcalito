---
/**
 * The thumb bar on phones: the four things people come for, always one tap
 * away. Hidden from md up, where the header carries them.
 */
import type { Locale } from '../domain/types';
import { t } from '../i18n/ui';
import { href } from '../server/page';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const items = [
  ['/menu', 'nav.menu', 'M4 6h16M4 12h16M4 18h10'],
  ['/tonight', 'nav.tonight', 'M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z'],
  ['/reserve', 'nav.book', 'M5 8h14v12H5zM8 4v4M16 4v4M5 12h14'],
] as const;
---
<nav
  class="fixed inset-x-0 bottom-0 z-40 border-t border-ink/10 bg-cream pb-[env(safe-area-inset-bottom)] md:hidden"
  aria-label="Quick"
>
  <ul class="grid grid-cols-4">
    {items.map(([p, key, d]) => (
      <li>
        <a
          href={href(locale, p)}
          class:list={['flex flex-col items-center gap-0.5 py-2 text-[11px] font-semibold', path === p ? 'text-hibiscus' : 'text-ink']}
          aria-current={path === p ? 'page' : undefined}
        >
          <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d={d} />
          </svg>
          {t(locale, key)}
        </a>
      </li>
    ))}
    <li>
      <a href={href(locale, '/checkout')} class="relative flex flex-col items-center gap-0.5 py-2 text-[11px] font-bold text-hibiscus">
        <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6" />
          <circle cx="10" cy="20" r="1.3" /><circle cx="17" cy="20" r="1.3" />
        </svg>
        {t(locale, 'nav.order')}
        <span data-cart-count class="absolute top-1 right-[calc(50%-1.4rem)] hidden min-w-5 rounded-full bg-hibiscus px-1 text-center text-[10px] text-cream"></span>
      </a>
    </li>
  </ul>
</nav>

<script>
  // The cart count, without shipping React to pages that do not need it.
  import { cartCount, getCart, subscribe } from '../lib/cart';

  const paint = () => {
    const n = cartCount(getCart());
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
      el.textContent = String(n);
      el.classList.toggle('hidden', n === 0);
    });
  };
  paint();
  subscribe(paint);
</script>
