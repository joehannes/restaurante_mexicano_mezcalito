---
/**
 * A signature dish as a 7-inch single: a printed sleeve with the record
 * peeking out. Jamaican-leaning dishes get the green-and-gold label, Mexican
 * ones the rosa-and-marigold, true fusion the lagoon.
 */
import type { Locale, MenuItem } from '../domain/types';
import { localized } from '../domain/types';
import { formatPrice } from '../lib/format';
import { fromPrice, fusionLabel } from '../lib/menuView';
import { dictionary, t } from '../i18n/ui';
import { href } from '../server/page';

interface Props {
  item: MenuItem;
  locale: Locale;
  side: string;
}
const { item, locale, side } = Astro.props;
const [sleeve, label] =
  item.fusion < 0 ? ['var(--c-jungle)', 'var(--c-gold)'] : item.fusion > 0 ? ['var(--c-hibiscus)', 'var(--c-gold)'] : ['var(--c-lagoon)', 'var(--c-hibiscus)'];
const price = fromPrice(item);
---
<a href={`${href(locale, '/menu')}?item=${item.id}`} class="single group block" aria-label={`${localized(item.name, locale)} — ${t(locale, 'menu.add')}`}>
  <div class="relative aspect-square">
    <div class="vinyl absolute inset-[6%] rounded-full bg-ink" aria-hidden="true">
      <div class="absolute inset-[34%] rounded-full" style={`background:${label}`}></div>
      <div class="absolute inset-[48%] rounded-full bg-cream"></div>
    </div>
    <div class="halftone absolute inset-0 flex flex-col justify-between rounded-xl p-4 text-cream shadow-[5px_5px_0_var(--c-ink)]" style={`background-color:${sleeve}`}>
      <p class="text-xs font-bold tracking-[0.2em] uppercase opacity-90">{side} · {fusionLabel(item.fusion, dictionary(locale))}</p>
      <p class="font-display text-3xl leading-[0.9] uppercase">{localized(item.name, locale)}</p>
      <p class="flex items-center justify-between text-sm font-bold">
        <span>{item.variants?.length ? `${t(locale, 'menu.from')} ` : ''}{formatPrice(price, locale)}</span>
        {item.heat >= 3 && <span aria-label={t(locale, 'menu.heatLevel', { n: item.heat })}>{'🌶'.repeat(Math.min(item.heat - 2, 3))}</span>}
      </p>
    </div>
  </div>
  {item.description && <p class="mt-3 line-clamp-2 text-sm">{localized(item.description, locale)}</p>}
</a>

<style>
  .vinyl {
    transform: translateX(0) rotate(0deg);
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .single:hover .vinyl,
  .single:focus-visible .vinyl {
    transform: translateX(28%) rotate(160deg);
  }
</style>
