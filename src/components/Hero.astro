---
/**
 * The home page's hero: a night on Mezcalito's terrace, filmed there, looping
 * silently behind a tint that follows Bávaro's time of day (and the season's
 * colours). Across the top runs a string of lights with polaroids pegged to
 * it: whichever ones staff tick "In the hero" under Admin → Polaroid wall.
 *
 * Play with it: the polaroids sway on their pegs; brush the pointer through
 * them and they swing; drag one and it springs back to the line; tap one
 * and it opens up big with a camera flash. The scene leans with the pointer
 * and a warm spotlight follows it. Without JavaScript the poster frame and
 * the polaroids are simply there; with reduced motion nothing moves.
 */
import '@fontsource/permanent-marker/latin-400.css';
import type { PageContext } from '../server/page';
import type { GalleryItem } from '../server/gallery';
import { localized } from '../domain/types';
import { activeSpecials } from '../domain/schedule';
import { formatClock } from '../lib/format';
import { t } from '../i18n/ui';
import { href } from '../server/page';
import OpenStatus from './OpenStatus.astro';

interface Props {
  ctx: PageContext;
  /** The polaroids for the string of lights, in order. */
  polaroids: GalleryItem[];
}
const { ctx, polaroids } = Astro.props;
const { locale, part, season } = ctx;

/** The colour grade over the footage, from one corner to the other, in the palette (so seasons re-skin it). */
const TINT = {
  morning: ['var(--c-gold)', 'var(--c-hibiscus)'],
  midday: ['var(--c-lagoon)', 'var(--c-gold)'],
  sunset: ['var(--c-hibiscus)', 'var(--c-sunset)'],
  night: ['var(--c-mezcal)', 'var(--c-lagoon)'],
} as const;
const [tintTop, tintMid] = TINT[part];

const happyHour = activeSpecials(ctx.now, ctx.specials, ctx.tz).find((s) => s.id === 'happy-hour');
const kicker = season ? localized(season.hero.kicker, locale) : t(locale, `hero.${part}.kicker` as const);
const headline = season ? localized(season.hero.headline, locale) : t(locale, `hero.${part}.headline` as const);
const body = season ? localized(season.hero.body, locale) : `${t(locale, 'brand.tagline')} · ${t(locale, 'brand.slogan')}`;

/** The wire hangs in a shallow curve: height in % of the line's box at position u (0…1) along it. */
const SAG = 34;
const wireY = (u: number) => 8 + 4 * SAG * u * (1 - u);
const snaps = polaroids.slice(0, 9);
const PHONE = 5;
// Spread along the wire, kept clear of the screen edges.
const along = (i: number, n: number, edge: number) => edge + (1 - 2 * edge) * ((i + 0.5) / n);
const placed = snaps.map((p, i) => {
  const u = along(i, snaps.length, 0.07);
  const um = along(i, Math.min(snaps.length, PHONE), 0.1);
  return { p, u, y: wireY(u), um, ym: wireY(um), caption: localized(p.caption, locale) };
});
const bulbs = Array.from({ length: 25 }, (_, i) => ({ u: i / 24, y: wireY(i / 24), delay: (i * 0.37) % 2.4 }));
const tapes = ['var(--c-gold)', 'var(--c-lagoon)', 'var(--c-hibiscus)', 'var(--c-jungle)', 'var(--c-sunset)'];
---
<section class="hero relative isolate overflow-hidden bg-ink text-cream" data-hero data-part={part}>
  <!-- A night on the terrace: Mezcalito's own footage, cut to a silent loop. -->
  <div class="stage absolute inset-0 -z-20" aria-hidden="true">
    <video data-loop="/video/hero.mp4" data-decor poster="/video/hero-poster.webp" muted loop playsinline preload="none" class="size-full object-cover"></video>
  </div>
  <div class="tint absolute inset-0 -z-10" style={`--tint-top:${tintTop}; --tint-mid:${tintMid}`} aria-hidden="true"></div>
  <div class="shade absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="halftone absolute inset-0 -z-10 opacity-50 mix-blend-overlay" aria-hidden="true"></div>
  <div class="bokeh absolute inset-0 -z-10" aria-hidden="true">
    {[0, 1, 2, 3, 4, 5, 6].map((i) => <span style={`--i:${i}`}></span>)}
  </div>
  <div class="spot absolute inset-0 -z-10" aria-hidden="true"></div>

  <!-- The string of lights, with the polaroids pegged to it. -->
  <div class="line relative" data-line>
    <svg class="absolute inset-0 size-full overflow-visible" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true">
      <path d={`M0 ${wireY(0)} Q500 ${8 + 2 * SAG} 1000 ${wireY(1)}`} fill="none" stroke="#141210" stroke-width="2" vector-effect="non-scaling-stroke" />
    </svg>
    {bulbs.map((b, i) => (
      <span class:list={['bulb', i % 2 === 1 && 'hidden md:block']} style={`left:${b.u * 100}%; top:${b.y}%; animation-delay:${b.delay}s`} aria-hidden="true"></span>
    ))}
    {placed.map(({ p, u, y, um, ym, caption }, i) => (
      <button
        type="button"
        class:list={['snap', i >= PHONE && 'hidden md:block']}
        data-snap={i}
        data-kind={p.kind}
        data-src={p.src}
        data-poster={p.poster ?? ''}
        data-caption={caption}
        aria-label={caption}
        style={`--u:${u * 100}%; --y:${y}%; --um:${um * 100}%; --ym:${ym}%; --r:${p.tilt}deg; --tape:${tapes[i % tapes.length]}; --sway:${4.2 + (i % 4) * 0.7}s; --i:${i}`}
      >
        <span class="swinger">
          <span class="peg" aria-hidden="true"></span>
          <span class="card">
            {p.kind === 'video' ? (
              <video data-loop={p.src} data-decor poster={p.poster ?? undefined} muted loop playsinline preload="none" aria-hidden="true"></video>
            ) : (
              <img src={p.src} alt="" width="200" height="200" decoding="async" />
            )}
            <span class="cap">{caption}</span>
          </span>
        </span>
      </button>
    ))}
  </div>

  <div class="relative mx-auto flow-root max-w-6xl px-4 pt-2 pb-10 md:pb-14">
    <!-- Mezcalito's own logo. Tap it and the sound system answers with an airhorn. -->
    <button
      type="button"
      data-airhorn
      class="logo-horn group relative float-right ml-4 w-28 cursor-pointer md:-mt-6 md:w-56"
      aria-label={t(locale, 'hero.airhorn')}
      title={t(locale, 'hero.airhorn')}
    >
      <span class="rings" aria-hidden="true"><span></span><span></span></span>
      <img
        src="/img/logo-320.webp"
        srcset="/img/logo-160.webp 160w, /img/logo-320.webp 320w, /img/logo-640.webp 640w"
        sizes="(min-width: 768px) 224px, 112px"
        alt="Mezcalito Bar & Grill"
        width="224"
        height="259"
        fetchpriority="high"
        class="relative h-auto w-full drop-shadow-[0_8px_16px_rgba(0,0,0,0.6)]"
      />
      <span class="tap sticker absolute -top-3 -left-8 bg-gold text-[10px] text-ink md:-left-6 md:text-sm" style="--tilt:-12deg" aria-hidden="true">📯 {t(locale, 'hero.tap')}</span>
    </button>
    <p class="flex items-center gap-2 font-display tracking-wide text-gold uppercase">
      <span class="live inline-flex items-center gap-1.5 rounded-full bg-ink/60 px-2 py-0.5 text-xs tracking-[0.18em] text-cream" aria-hidden="true"><span></span>REC</span>
      {kicker}
    </p>
    <h1 class="mt-1 font-display text-5xl leading-[0.95] uppercase drop-shadow-[3px_3px_0_var(--c-ink)] sm:text-6xl md:text-8xl" aria-label={headline}>
      {headline.split(' ').map((word, i) => (
        <><span class="word" style={`--i:${i}`} aria-hidden="true">{word}</span>{' '}</>
      ))}
    </h1>
    <p class="mt-3 max-w-xl text-lg">{body}</p>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <OpenStatus ctx={ctx} class="bg-ink/50" />
      {happyHour && (
        <span class="sticker bg-gold text-ink" style="--tilt:-4deg">
          {t(locale, 'hero.happyHourEnds', { time: formatClock(happyHour.end, locale) })}
        </span>
      )}
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={href(locale, '/menu')} class="cone shine rounded-full bg-hibiscus px-7 py-3 text-lg font-bold text-cream shadow-[4px_4px_0_var(--c-ink)]">
        {t(locale, 'hero.order')}
      </a>
      <a href={href(locale, '/reserve')} class="rounded-full border-2 border-cream bg-ink/30 px-7 py-3 text-lg font-bold backdrop-blur-sm">
        {t(locale, 'hero.book')}
      </a>
    </div>
    {season && (
      <p class="mt-5">
        <a href={href(locale, `/season/${season.slug}`)} class="font-bold underline decoration-gold decoration-4 underline-offset-4">
          {t(locale, 'season.see', { name: localized(season.name, locale) })} →
        </a>
      </p>
    )}
    {snaps.length > 0 && <p class="hint mt-6 text-sm text-cream/75">📸 {t(locale, 'hero.snapHint')}</p>}
  </div>

  <!-- A polaroid, opened up big. -->
  <dialog class="viewer" data-viewer aria-label={t(locale, 'gallery.title')}>
    <div class="flash" aria-hidden="true"></div>
    <figure class="sheet">
      <div class="shot" data-shot></div>
      <figcaption data-cap></figcaption>
    </figure>
    <div class="controls">
      <button type="button" data-prev aria-label={t(locale, 'hero.prev')}>←</button>
      <a href={href(locale, '/gallery')} class="more">{t(locale, 'gallery.more')} →</a>
      <button type="button" data-next aria-label={t(locale, 'hero.next')}>→</button>
    </div>
    <button type="button" class="close" data-close aria-label={t(locale, 'hero.close')}>✕</button>
  </dialog>
</section>

<script>
  // The hero's toys: lean with the pointer, brush and drag the polaroids,
  // and open one up. Nothing here runs for reduced motion except opening.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const snaps = [...hero.querySelectorAll<HTMLButtonElement>('[data-snap]')];
    const viewer = hero.querySelector<HTMLDialogElement>('[data-viewer]')!;
    const shot = viewer.querySelector<HTMLElement>('[data-shot]')!;
    const cap = viewer.querySelector<HTMLElement>('[data-cap]')!;

    /** A swing, as if someone brushed past it. */
    const swing = (snap: HTMLElement, dir: number, force = 1) => {
      if (still || snap.dataset.busy) return;
      snap.dataset.busy = '1';
      const swinger = snap.querySelector<HTMLElement>('.swinger')!;
      const a = 16 * force * dir;
      swinger
        .animate([{ rotate: '0deg' }, { rotate: `${a}deg` }, { rotate: `${-a * 0.6}deg` }, { rotate: `${a * 0.32}deg` }, { rotate: `${-a * 0.14}deg` }, { rotate: '0deg' }], {
          duration: 1700,
          easing: 'ease-out',
        })
        .finished.finally(() => delete snap.dataset.busy);
    };

    // The scene leans away from the pointer; a warm spotlight follows it.
    let lastX = 0;
    let frame = 0;
    hero.addEventListener('pointermove', (e) => {
      const box = hero.getBoundingClientRect();
      const dx = e.clientX - lastX;
      lastX = e.clientX;
      if (e.pointerType === 'mouse') {
        const over = (e.target as Element).closest<HTMLElement>('[data-snap]');
        if (over && Math.abs(dx) > 3 && !dragging) swing(over, Math.sign(dx), Math.min(1, Math.abs(dx) / 18));
      }
      if (still) return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        hero.style.setProperty('--mx', `${e.clientX - box.left}px`);
        hero.style.setProperty('--my', `${e.clientY - box.top}px`);
        hero.style.setProperty('--px', ((e.clientX - box.left) / box.width - 0.5).toFixed(3));
        hero.style.setProperty('--py', ((e.clientY - box.top) / box.height - 0.5).toFixed(3));
      });
    });

    // A gust when the page starts to scroll, rippling along the line.
    let gustAt = 0;
    addEventListener(
      'scroll',
      () => {
        const now = Date.now();
        if (now - gustAt < 4000 || scrollY > hero.offsetHeight) return;
        gustAt = now;
        snaps.forEach((s, i) => setTimeout(() => swing(s, 1, 0.55), i * 70));
      },
      { passive: true },
    );

    // Drag one off the line and it springs back; a tap opens it.
    let dragging: { snap: HTMLElement; x: number; y: number; moved: boolean } | undefined;
    let suppressClick = false;
    snaps.forEach((snap) => {
      const swinger = snap.querySelector<HTMLElement>('.swinger')!;
      snap.addEventListener('pointerdown', (e) => {
        if (still || e.button !== 0) return;
        dragging = { snap, x: e.clientX, y: e.clientY, moved: false };
        snap.setPointerCapture(e.pointerId);
      });
      snap.addEventListener('pointermove', (e) => {
        if (dragging?.snap !== snap) return;
        const dx = e.clientX - dragging.x;
        const dy = Math.max(-20, e.clientY - dragging.y);
        if (!dragging.moved && Math.hypot(dx, dy) < 6) return;
        dragging.moved = true;
        snap.classList.add('held');
        swinger.style.translate = `${dx}px ${dy}px`;
        swinger.style.rotate = `${Math.max(-35, Math.min(35, -dx * 0.12))}deg`;
      });
      const release = () => {
        if (dragging?.snap !== snap) return;
        const { moved } = dragging;
        dragging = undefined;
        snap.classList.remove('held');
        if (!moved) return;
        // The click a drag ends with (if the browser sends one) must not open the viewer.
        suppressClick = true;
        setTimeout(() => (suppressClick = false), 60);
        const from = { translate: swinger.style.translate || '0 0', rotate: swinger.style.rotate || '0deg' };
        swinger.style.translate = '';
        swinger.style.rotate = '';
        swinger.animate(
          [
            from,
            { translate: '0 -6px', rotate: `${-parseFloat(from.rotate) * 0.5}deg`, offset: 0.45 },
            { translate: '0 2px', rotate: `${parseFloat(from.rotate) * 0.2}deg`, offset: 0.7 },
            { translate: '0 0', rotate: '0deg' },
          ],
          { duration: 900, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' },
        );
      };
      snap.addEventListener('pointerup', release);
      snap.addEventListener('pointercancel', release);
      snap.addEventListener('click', () => {
        if (suppressClick) return;
        open(Number(snap.dataset.snap));
      });
    });

    // The viewer: one polaroid, big, with a camera flash.
    let current = 0;
    const show = (i: number) => {
      current = (i + snaps.length) % snaps.length;
      const { kind, src, poster, caption } = snaps[current]!.dataset;
      shot.replaceChildren();
      if (kind === 'video') {
        const v = document.createElement('video');
        Object.assign(v, { src: src!, muted: true, loop: true, playsInline: true, autoplay: !still, controls: still });
        if (poster) v.poster = poster;
        shot.appendChild(v);
      } else {
        const img = document.createElement('img');
        Object.assign(img, { src: src!, alt: caption ?? '' });
        shot.appendChild(img);
      }
      cap.textContent = caption ?? '';
      viewer.classList.remove('flashing');
      void viewer.offsetWidth;
      viewer.classList.add('flashing');
    };
    const open = (i: number) => {
      show(i);
      viewer.showModal();
    };
    viewer.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
    viewer.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));
    viewer.querySelector('[data-close]')!.addEventListener('click', () => viewer.close());
    viewer.addEventListener('click', (e) => e.target === viewer && viewer.close());
    viewer.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    viewer.addEventListener('close', () => shot.replaceChildren());
  }
</script>

<style>
  .hero {
    --px: 0;
    --py: 0;
    --mx: 70%;
    --my: 30%;
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 768px) {
    .hero {
      min-height: min(94svh, 860px);
    }
  }
  .hero > .relative.mx-auto {
    margin-top: auto;
    width: 100%;
  }

  /* The footage leans gently away from the pointer. */
  .stage {
    transform: scale(1.08) translate(calc(var(--px) * -18px), calc(var(--py) * -12px));
    transition: transform 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .stage video {
    filter: saturate(1.25) contrast(1.08);
  }
  /* A colour grade over the footage: blended, so the faces and lights keep their detail. */
  .tint {
    background: linear-gradient(155deg, var(--tint-top) 10%, var(--tint-mid) 90%);
    mix-blend-mode: overlay;
    opacity: 0.9;
  }
  /* Dark enough at the bottom for the words, and round the edges like a lens. */
  .shade {
    background:
      linear-gradient(to bottom, rgb(20 18 16 / 0.35) 0%, transparent 22%, rgb(20 18 16 / 0.35) 48%, rgb(20 18 16 / 0.88) 78%, var(--c-ink) 100%),
      radial-gradient(130% 90% at 50% 30%, transparent 55%, rgb(20 18 16 / 0.55) 100%);
  }
  /* Out-of-focus lights drifting past the lens. */
  .bokeh > span {
    position: absolute;
    left: calc(8% + var(--i) * 13%);
    top: calc(18% + (var(--i) * 37 % 50) * 1%);
    width: calc(3rem + (var(--i) * 17 % 5) * 1rem);
    aspect-ratio: 1;
    border-radius: 999px;
    background: radial-gradient(circle, rgb(255 215 106 / 0.45), rgb(255 215 106 / 0.08) 60%, transparent 70%);
    mix-blend-mode: screen;
    filter: blur(2px);
    animation: bokeh calc(14s + var(--i) * 2.3s) ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -3.1s);
  }
  .bokeh > span:nth-child(3n) {
    background: radial-gradient(circle, color-mix(in srgb, var(--c-hibiscus) 50%, transparent), transparent 70%);
  }
  .bokeh > span:nth-child(3n + 1) {
    background: radial-gradient(circle, color-mix(in srgb, var(--c-lagoon) 45%, transparent), transparent 70%);
  }
  @keyframes bokeh {
    from { transform: translate(0, 0) scale(0.9); opacity: 0.5; }
    50% { opacity: 1; }
    to { transform: translate(6vw, -4vh) scale(1.15); opacity: 0.6; }
  }
  .spot {
    background: radial-gradient(circle 22rem at var(--mx) var(--my), rgb(255 215 106 / 0.16), transparent 70%);
    mix-blend-mode: screen;
    transition: background-position 300ms;
  }

  /* ── The string of lights ───────────────────────────────────────────── */
  .line {
    height: 12.5rem;
    margin: 0.5rem -2% 0;
    transform: translateX(calc(var(--px) * 12px));
    transition: transform 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @media (min-width: 768px) {
    .line {
      height: 19rem;
    }
  }
  @media (min-width: 1280px) {
    .line {
      height: 21rem;
    }
  }
  .bulb {
    position: absolute;
    width: 0.55rem;
    height: 0.8rem;
    translate: -50% 1px;
    border-radius: 45% 45% 50% 50%;
    background: #ffd76a;
    box-shadow:
      0 0 6px 2px rgb(255 215 106 / 0.75),
      0 0 22px 6px rgb(255 190 80 / 0.35);
    animation: twinkle 2.6s ease-in-out infinite;
  }
  [data-part='morning'] .bulb,
  [data-part='midday'] .bulb {
    box-shadow: 0 0 6px 1px rgb(255 215 106 / 0.6);
  }

  /* A polaroid hanging from a peg on the wire. */
  .snap {
    position: absolute;
    z-index: 1;
    left: var(--um);
    top: var(--ym);
    width: clamp(4.4rem, 18vw, 6.8rem);
    translate: -50% -0.35rem;
    transform-origin: 50% 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: grab;
    touch-action: pan-y;
    animation:
      peg-in 800ms cubic-bezier(0.34, 1.56, 0.64, 1) both,
      snap-sway var(--sway) ease-in-out infinite alternate;
    animation-delay: calc(200ms + var(--i) * 110ms), calc(var(--i) * -0.6s);
  }
  @media (min-width: 768px) {
    .snap {
      left: var(--u);
      top: var(--y);
      width: clamp(6.5rem, 10vw, 9.5rem);
    }
  }
  .snap:hover,
  .snap:focus-visible,
  .snap.held {
    z-index: 4;
  }
  .snap.held {
    cursor: grabbing;
  }
  .swinger {
    display: block;
    transform-origin: 50% 0;
  }
  .peg {
    position: absolute;
    z-index: 2;
    top: -0.25rem;
    left: 50%;
    width: 0.55rem;
    height: 1.35rem;
    translate: -50% 0;
    border-radius: 2px;
    background: linear-gradient(90deg, #c99a62, #e9c48f 45%, #b8854d);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.5);
  }
  .peg::after {
    content: '';
    position: absolute;
    inset: 40% -1px auto;
    height: 2px;
    background: #8a8a8a;
  }
  .card {
    display: block;
    margin-top: 0.6rem;
    padding: 6% 6% 0;
    background: #fffdf8;
    rotate: var(--r);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.3),
      0 14px 24px -8px rgb(0 0 0 / 0.6);
    transition:
      rotate 350ms cubic-bezier(0.34, 1.56, 0.64, 1),
      scale 350ms cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 300ms;
  }
  .card > img,
  .card > video {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: #2a2622;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }
  .cap {
    display: block;
    padding: 0.35em 0.1em 0.5em;
    font-family: 'Permanent Marker', 'Comic Sans MS', cursive;
    font-size: clamp(0.5rem, 2.3vw, 0.85rem);
    line-height: 1.05;
    text-align: center;
    color: #1f2a6b;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.6em;
  }
  @media (min-width: 768px) {
    .cap {
      font-size: clamp(0.6rem, 0.95vw, 0.85rem);
    }
  }
  .snap:hover .card,
  .snap:focus-visible .card,
  .snap.held .card {
    rotate: 0deg;
    scale: 1.14;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.3),
      0 26px 36px -10px rgb(0 0 0 / 0.7);
  }
  .snap:focus-visible {
    outline: none;
  }
  .snap:focus-visible .card {
    outline: 3px solid var(--c-gold);
    outline-offset: 3px;
  }
  @keyframes peg-in {
    from { opacity: 0; transform: translateY(-40px) rotate(-14deg); }
  }
  @keyframes snap-sway {
    from { transform: rotate(-2.4deg); }
