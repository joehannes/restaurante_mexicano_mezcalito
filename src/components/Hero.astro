---
/**
 * The facade hero: Mezcalito's white terrace on Calle Pedro Mir, drawn, with
 * the sky set by Bávaro's actual time of day. Morning sun, midday blue, a
 * happy-hour sunset, and at night the string lights come on over the bays.
 *
 * Inline SVG, no image request: it paints with the HTML and costs nothing for
 * the largest-contentful-paint budget. Only the bulbs (opacity) and the palms
 * (transform) move. Mezcalito's own logo hangs over the terrace.
 */
import type { PageContext } from '../server/page';
import { localized } from '../domain/types';
import { activeSpecials } from '../domain/schedule';
import { formatClock } from '../lib/format';
import { t } from '../i18n/ui';
import { href } from '../server/page';
import OpenStatus from './OpenStatus.astro';

interface Props {
  ctx: PageContext;
}
const { ctx } = Astro.props;
const { locale, part, season } = ctx;

const SKY = {
  morning: ['#ffd8a8', '#bfe7f3'],
  midday: ['#68cfe3', '#c9f1f6'],
  sunset: ['var(--c-mezcal)', 'var(--c-sunset)'],
  night: ['#0d0b1a', 'var(--c-mezcal)'],
} as const;
const [skyTop, skyBottom] = SKY[part];
const night = part === 'night' || part === 'sunset';

const happyHour = activeSpecials(ctx.now, ctx.specials, ctx.tz).find((s) => s.id === 'happy-hour');
const kicker = season ? localized(season.hero.kicker, locale) : t(locale, `hero.${part}.kicker` as const);
const headline = season ? localized(season.hero.headline, locale) : t(locale, `hero.${part}.headline` as const);
const body = season ? localized(season.hero.body, locale) : `${t(locale, 'brand.tagline')} · ${t(locale, 'brand.slogan')}`;
// The party wall. On phones only the corners of the sky and the pavers are
// free, so four go up; wide screens have open sky either side of the terrace.
interface Snap {
  img: string;
  caption: string;
  r: number;
  place: string;
  flip?: boolean;
  back?: string;
}
const snaps: Snap[] = [
  { img: 'full-house', caption: 'Friday ♥', r: -8, place: 'left-[2%] top-[4%] w-[17%] md:left-[2%] md:top-[5%] md:w-[11.5%]' },
  { img: 'sparklers', caption: '¡Wepa!', r: 9, flip: true, place: 'right-[2%] top-[2%] w-[16%] md:right-[3%] md:top-[4%] md:w-[11%]' },
  { img: 'sip', caption: 'MEGA', r: 6, place: 'left-[4%] bottom-[2%] w-[15%] md:left-[9.5%] md:bottom-[4%] md:w-[10.5%]' },
  { img: 'tacos-board', caption: 'Taco Tuesday', r: -5, place: 'left-[22%] bottom-[2%] w-[14%] md:hidden' },
  { img: 'dj-booth', caption: 'The selector', r: 5, place: 'hidden md:block md:left-[10.5%] md:top-[34%] md:w-[10%]' },
  { img: 'memories', caption: '¡Cumple!', r: -7, flip: true, place: 'hidden md:block md:right-[12.5%] md:top-[40%] md:w-[9.5%]' },
  { img: 'bartender', caption: 'Shake it!', r: 11, place: 'hidden md:block md:left-[1%] md:top-[50%] md:w-[9.5%]' },
  { img: 'welcome', caption: '¡Bienvenidos!', r: -10, back: 'Best night ever ♥ Mezcalito', place: 'hidden lg:block lg:right-[1.5%] lg:top-[47%] lg:w-[9.5%]' },
  { img: 'one-love', caption: 'One love', r: 4, place: 'hidden xl:block xl:left-[19%] xl:top-[2%] xl:w-[8%]' },
  { img: 'tacos-board', caption: 'Taco Tuesday', r: -4, place: 'hidden xl:block xl:right-[19%] xl:top-[1%] xl:w-[8%]' },
];

const bulbs = Array.from({ length: 17 }, (_, i) => {
  // Hang each bulb from the quadratic wire drawn below (M46 118 Q180 136 314 118).
  const u = i / 16;
  return { x: 46 + 268 * u, y: 118 + 36 * u * (1 - u), delay: (i % 5) * 0.4 };
});
---
<section class:list={['relative overflow-hidden', night ? 'bg-ink text-cream' : 'bg-cream text-ink']} data-part={part}>
  <!-- The sky and the pavers run on past the drawing to the screen edges, so on a
       wide screen the whole terrace shows instead of a crop of it. -->
  <div class="relative" style={`background: linear-gradient(to bottom, transparent 88%, #b5523b 88%), linear-gradient(to bottom, ${skyTop}, ${skyBottom})`}>
  <svg viewBox="0 0 360 200" class="mx-auto block w-full max-w-5xl" role="img" aria-label="Mezcalito’s terrace on Calle Pedro Mir" preserveAspectRatio="xMidYMax meet" style="max-height: 58vh">
    <defs>
      <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color={skyTop} />
        <stop offset="1" stop-color={skyBottom} />
      </linearGradient>
      <radialGradient id="glow" cx="0.5" cy="0.3" r="0.8">
        <stop offset="0" stop-color="#ffcf6b" stop-opacity="0.9" />
        <stop offset="1" stop-color="#ffcf6b" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="360" height="200" fill="url(#sky)" />

    {part === 'night' ? (
      <g fill="var(--c-cream)">
        <path d="M300 30a14 14 0 1 0 12 22 11 11 0 1 1-12-22z" />
        {[[40, 20], [90, 38], [140, 14], [210, 28], [250, 12], [330, 60]].map(([x, y], i) => (
          <circle cx={x} cy={y} r="1.1" opacity="0.8" class="star" style={`animation-delay:${i * 0.7}s`} />
        ))}
        <!-- Now and then a shooting star crosses over the bay. -->
        <path class="shooting" d="M0 0l-22 9" stroke="var(--c-cream)" stroke-width="1.2" stroke-linecap="round" style="transform: translate(260px, 8px)" />
      </g>
    ) : (
      <>
        <circle
          class="sun"
          cx={part === 'morning' ? 70 : part === 'midday' ? 200 : 180}
          cy={part === 'morning' ? 52 : part === 'midday' ? 26 : 70}
          r={part === 'sunset' ? 26 : 16}
          fill={part === 'sunset' ? 'var(--c-gold)' : '#fff3b0'}
        />
        {part !== 'sunset' && (
          <g fill="#ffffff" opacity="0.9">
            <g class="cloud"><ellipse cx="0" cy="34" rx="20" ry="6" /><ellipse cx="10" cy="30" rx="11" ry="7" /></g>
            <g class="cloud" style="animation-duration: 70s; animation-delay: -30s"><ellipse cx="0" cy="54" rx="15" ry="4.5" /><ellipse cx="7" cy="51" rx="8" ry="5" /></g>
          </g>
        )}
        <!-- A seagull gliding over Calle Pedro Mir towards the beach. -->
        <path class="gull" d="M0 0q4-4 8 0q4-4 8 0" fill="none" stroke="#141210" stroke-width="1.1" stroke-linecap="round" />
      </>
    )}

    <!-- Palms, swaying from the base of the trunk -->
    <g class="palm" style="transform-origin: 20px 175px" fill={night ? '#08070d' : '#1d5c3a'}>
      <path d="M18 175c2-30 4-62 10-92l3 1c-5 30-6 61-7 91z" />
      <path d="M29 84c-14-8-30-6-38 2 12-4 25-2 38-2zM29 84c-6-12-20-18-32-16 12 2 24 8 32 16zM29 84c10-12 26-14 36-10-12 0-24 4-36 10zM29 84c14-4 28 2 34 12-10-6-22-10-34-12z" />
    </g>
    <g class="palm" style="transform-origin: 342px 178px; animation-delay: -2s" fill={night ? '#08070d' : '#1d5c3a'}>
      <path d="M340 178c-1-28-3-55-9-80l-3 1c5 26 6 52 6 79z" />
      <path d="M330 99c14-8 30-6 38 2-12-4-25-2-38-2zM330 99c6-12 20-18 32-16-12 2-24 8-32 16zM330 99c-10-12-26-14-36-10 12 0 24 4 36 10z" />
    </g>

    <!-- The building -->
    <rect x="34" y="66" width="292" height="114" fill={night ? '#e9e2d4' : '#fbfaf6'} />
    <rect x="34" y="66" width="292" height="30" fill={night ? '#f4efe4' : '#ffffff'} stroke="#141210" stroke-opacity="0.12" />
    <text x="180" y="89" text-anchor="middle" font-family="Anton, Impact, sans-serif" font-size="22" letter-spacing="7" fill="#141210">MEZCALITO</text>

    <!-- Three bays between four columns; lit from inside after dark -->
    {[0, 1, 2].map((i) => (
      <g>
        <rect x={52 + i * 88} y="100" width="80" height="72" fill={night ? '#3a2416' : '#6e5a48'} />
        {night && <rect x={52 + i * 88} y="100" width="80" height="72" fill="url(#glow)" />}
      </g>
    ))}
    {[0, 1, 2, 3].map((i) => <rect x={42 + i * 88} y="96" width="10" height="80" fill={night ? '#f4efe4' : '#ffffff'} />)}

    <!-- String lights -->
    <path d="M46 118 Q180 136 314 118" fill="none" stroke="#141210" stroke-width="0.8" opacity={night ? 0.9 : 0.35} />
    {bulbs.map((b) => (
      <circle cx={b.x} cy={b.y + 3} r="2.2" fill={night ? '#ffd76a' : '#d9d2c4'} class={night ? 'bulb' : undefined} style={`animation-delay:${b.delay}s`} />
    ))}

    <!-- After dark the music spills out of the bays. -->
    {night && (
      <g fill="#ffd76a" font-family="DM Sans, sans-serif" font-size="11" font-weight="700" aria-hidden="true">
        {[[86, 0], [140, 1.4], [178, 2.6], [228, 0.8], [272, 2]].map(([x, delay], i) => (
          <text x={x} y="150" class="note" style={`animation-delay:${delay}s`}>{i % 2 ? '♫' : '♪'}</text>
        ))}
      </g>
    )}

    <!-- Red pavers -->
    <rect x="0" y="176" width="360" height="24" fill="#b5523b" />
    <path d="M0 184h360M0 192h360" stroke="#8f3d2b" stroke-width="0.8" />
  </svg>

  <!-- Snapshots from real nights at Mezcalito, taped up around the terrace like
       a party wall: tilted every which way, a couple flipped, one lying face
       down until you turn it over. -->
  <div class="polaroids pointer-events-none absolute inset-0" aria-hidden="true">
    {snaps.map((p, i) => (
      <figure
        class:list={['polaroid tape pointer-events-auto absolute', p.place, p.flip && 'flipped', p.back && 'facedown']}
        style={`--r:${p.r}deg; --tape:${-p.r * 1.5}deg; --i:${i}; --sway:${5 + (i % 4)}s`}
      >
        <div class="card">
          <div class="front">
            <img src={`/img/polaroids/${p.img}.webp`} alt="" width="180" height="180" decoding="async" fetchpriority="low" />
            <figcaption>{p.caption}</figcaption>
          </div>
          {p.back && <div class="back"><p>{p.back}</p></div>}
        </div>
      </figure>
    ))}
  </div>
  </div>

  <div class="mx-auto flow-root max-w-6xl px-4 pt-6 pb-8">
    <!-- Mezcalito's own logo, as on the menus and the furniture, hung over the
         terrace. Tap it and the sound system answers with an airhorn. -->
    <button
      type="button"
      data-airhorn
      class="logo-horn group relative float-right -mt-20 ml-4 w-28 cursor-pointer md:-mt-44 md:w-60"
      aria-label={t(locale, 'hero.airhorn')}
      title={t(locale, 'hero.airhorn')}
    >
      <span class="rings" aria-hidden="true"><span></span><span></span></span>
      <img
        src="/img/logo-320.webp"
        srcset="/img/logo-160.webp 160w, /img/logo-320.webp 320w, /img/logo-640.webp 640w"
        sizes="(min-width: 768px) 240px, 112px"
        alt="Mezcalito Bar & Grill"
        width="240"
        height="278"
        fetchpriority="high"
        class="relative h-auto w-full drop-shadow-[0_6px_12px_rgba(0,0,0,0.45)]"
      />
      <span class="tap sticker absolute -top-3 -left-8 bg-gold text-[10px] text-ink md:-left-6 md:text-sm" style="--tilt:-12deg" aria-hidden="true">📯 {t(locale, 'hero.tap')}</span>
    </button>
    <p class="font-display tracking-wide text-gold uppercase">{kicker}</p>
    <h1 class="mt-1 font-display text-5xl leading-[0.95] uppercase sm:text-6xl md:text-7xl" aria-label={headline}>
      {headline.split(' ').map((word, i) => (
        <><span class="word" style={`--i:${i}`} aria-hidden="true">{word}</span>{' '}</>
      ))}
    </h1>
    <p class="mt-3 max-w-xl text-lg opacity-90">{body}</p>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <OpenStatus ctx={ctx} class={night ? 'bg-cream/10' : 'bg-ink/5'} />
      {happyHour && (
        <span class="sticker bg-gold text-ink" style="--tilt:-4deg">
          {t(locale, 'hero.happyHourEnds', { time: formatClock(happyHour.end, locale) })}
        </span>
      )}
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={href(locale, '/menu')} class="cone shine rounded-full bg-hibiscus px-7 py-3 text-lg font-bold text-cream shadow-[4px_4px_0_var(--c-ink)]">
        {t(locale, 'hero.order')}
      </a>
      <a
        href={href(locale, '/reserve')}
        class:list={['rounded-full border-2 px-7 py-3 text-lg font-bold', night ? 'border-cream' : 'border-ink']}
      >
        {t(locale, 'hero.book')}
      </a>
    </div>
    {season && (
      <p class="mt-5">
        <a href={href(locale, `/season/${season.slug}`)} class="font-bold underline decoration-gold decoration-4 underline-offset-4">
          {t(locale, 'season.see', { name: localized(season.name, locale) })} →
        </a>
      </p>
    )}
  </div>
</section>

<style>
  .palm {
    animation: sway 7s ease-in-out infinite;
  }
  .bulb,
  .star {
    animation: twinkle 3.2s ease-in-out infinite;
  }
  .sun {
    transform-box: fill-box;
    transform-origin: center;
    animation: glow 6s ease-in-out infinite;
  }
  @keyframes glow {
    50% { transform: scale(1.08); }
  }
  .cloud {
    animation: drift 52s linear infinite;
    animation-delay: -12s;
  }
  @keyframes drift {
    from { transform: translateX(-40px); }
    to { transform: translateX(400px); }
  }
  .gull {
    animation: glide 24s linear infinite;
    animation-delay: -6s;
  }
  @keyframes glide {
    from { transform: translate(-30px, 48px); }
    50% { transform: translate(180px, 30px); }
    to { transform: translate(400px, 44px); }
  }
  .shooting {
    opacity: 0;
    animation: shoot 9s ease-in infinite;
    animation-delay: 3s;
  }
  @keyframes shoot {
    0%, 88% { opacity: 0; transform: translate(260px, 8px); }
    90% { opacity: 1; }
    100% { opacity: 0; transform: translate(170px, 46px); }
  }
  .note {
    opacity: 0;
    animation: rise 4s ease-out infinite;
  }
  @keyframes rise {
    0% { opacity: 0; transform: translateY(0); }
    20% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-46px) rotate(-12deg); }
  }

  /* ── The party wall ───────────────────────────────────────────────── */
  .polaroid {
    z-index: 1;
    margin: 0;
    transform-origin: 50% -10%;
    rotate: var(--r);
    animation:
      pin-up 700ms cubic-bezier(0.34, 1.56, 0.64, 1) both,
      swing var(--sway) ease-in-out 900ms infinite alternate;
    animation-delay: calc(250ms + var(--i) * 90ms), calc(900ms + var(--i) * 90ms);
    perspective: 700px;
    transition: scale 250ms ease;
  }
  .polaroid:hover {
    z-index: 3;
    scale: 1.18;
  }
  .polaroid:hover .card {
    rotate: calc(var(--r) * -1);
  }
  .card {
    position: relative;
    display: grid;
    transform-style: preserve-3d;
    transition: transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1), rotate 300ms ease;
  }
  .front,
  .back {
    grid-area: 1 / 1;
    backface-visibility: hidden;
    background: #fffdf8;
    padding: 6% 6% 0;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.25),
      0 10px 20px -6px rgb(0 0 0 / 0.45);
  }
  .front img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    filter: saturate(1.1) contrast(1.04);
  }
  /* A couple of snapshots were printed the other way round. */
  .flipped .front img {
    transform: scaleX(-1);
  }
  .front figcaption {
    padding: 0.35em 0 0.55em;
    font-family: var(--font-display);
    font-size: clamp(0.45rem, 0.9vw, 0.85rem);
    line-height: 1;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
    color: var(--c-ink);
    white-space: nowrap;
  }
  /* Face down: the back of the photo, with a note scribbled on it. Turns over on hover. */
  .facedown .card {
    transform: rotateY(180deg);
  }
  .facedown:hover .card {
    transform: rotateY(0deg);
  }
  .back {
    transform: rotateY(180deg);
    display: grid;
    place-items: center;
    padding: 10%;
    background:
      repeating-linear-gradient(0deg, transparent 0 13px, rgb(18 179 184 / 0.18) 13px 14px),
      #f6efe0;
  }
  .back p {
    margin: 0;
    rotate: -6deg;
    font-weight: 700;
    font-style: italic;
    font-size: clamp(0.5rem, 0.95vw, 0.9rem);
    line-height: 1.25;
    text-align: center;
    color: var(--c-mezcal);
  }
  .polaroid.tape::before {
    top: -7px;
    width: 46%;
    height: 14px;
  }
  @keyframes pin-up {
    from { opacity: 0; transform: translateY(-30px) scale(1.25); }
    to { opacity: 1; transform: none; }
  }
  @keyframes swing {
    from { transform: rotate(-1.6deg); }
    to { transform: rotate(1.6deg); }
  }

  /* The headline drops in word by word, with a little dancehall bounce. */
  .word {
    display: inline-block;
    animation: drop 700ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(120ms + var(--i) * 110ms);
  }
  @keyframes drop {
    from { opacity: 0; transform: translateY(-0.6em) rotate(-6deg); }
    to { opacity: 1; transform: none; }
  }

  /* The logo's sound rings, and the "tap me" sticker that shows it plays. */
  .rings > span {
    position: absolute;
    inset: 18% 12% 30%;
    border: 3px solid var(--c-gold);
    border-radius: 999px;
    opacity: 0;
    animation: ring 3.2s ease-out infinite;
  }
  .rings > span + span {
    animation-delay: 1.6s;
  }
  @keyframes ring {
    0% { opacity: 0.7; transform: scale(0.8); }
    100% { opacity: 0; transform: scale(1.5); }
  }
  .tap {
    animation: bob 3s ease-in-out infinite;
    transition: opacity 200ms;
  }
  .logo-horn:hover .tap {
    opacity: 0;
  }
  .logo-horn:focus-visible {
    outline: 3px solid var(--c-gold);
    outline-offset: 4px;
    border-radius: 1rem;
  }
</style>
