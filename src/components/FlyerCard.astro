---
/**
 * One night on the line-up wall, as a dancehall flyer: the night's photo, a
 * colour block, the night in big poster type, when it runs, and the price on
 * a sticker.
 */
import type { Locale } from '../domain/types';
import { localized } from '../domain/types';
import type { SpecialRecord } from '../server/content';
import { formatClock, formatPrice } from '../lib/format';
import { t, weekdayName } from '../i18n/ui';
import { href } from '../server/page';

interface Props {
  special: SpecialRecord;
  locale: Locale;
  index: number;
  live?: boolean;
}
const { special, locale, index, live = false } = Astro.props;

// 2026-10-18 is a Sunday: date for weekday n is the 18th + n.
const dayName = (n: number) => weekdayName(`2026-10-${18 + n}`, locale);
const days = special.days.length ? special.days.map(dayName).join(' · ') : t(locale, 'tonight.everyDay');
const allDay = special.start <= '08:00' && special.end === '24:00';
const hours = allDay ? t(locale, 'tonight.allDay') : `${formatClock(special.start, locale)}–${formatClock(special.end, locale)}`;
const tilt = [-2, 1.5, -1, 2, -1.5][index % 5] ?? 0;
const ctaHref = special.cta === 'book' ? href(locale, '/reserve') : href(locale, '/menu');
const ctaText = special.cta === 'book' ? t(locale, 'nav.bookTable') : t(locale, 'nav.order');
// Each night's little mascot, bobbing in the corner of its flyer.
const MASCOT: Record<string, string> = {
  'happy-hour': '🍹',
  'taco-tuesday': '🌮',
  wingsday: '🍗',
  'ladies-night': '💃',
  'unlimited-hookah': '💨',
  'brunch-bubbly': '🥂',
  'rum-reggae': '🎤',
  flight: '✈️',
};
const mascot = MASCOT[special.id];
---
<div class="tape relative h-full" style={`--tape:${-tilt * 2}deg`}>
<article
  class="flyer halftone relative flex h-full min-h-64 flex-col justify-between overflow-hidden rounded-2xl p-5 shadow-[6px_6px_0_var(--c-ink)]"
  style={`--tilt:${tilt}deg; background-color: var(--c-${special.flyer.bg}); color: var(--c-${special.flyer.ink})`}
>
  <div>
    {special.image && (
      <img src={special.image} alt="" width="640" height="280" loading="lazy" decoding="async" class="-mx-5 -mt-5 mb-4 aspect-[16/7] w-[calc(100%+2.5rem)] max-w-none object-cover" />
    )}
    <p class="text-xs font-bold tracking-[0.18em] uppercase">{days}</p>
    <p class="text-xs font-semibold opacity-80">{hours}</p>
    <h3 class="mt-3 font-display text-4xl leading-[0.9] uppercase">{localized(special.title, locale)}</h3>
    {special.id === 'rum-reggae' && (
      <p class="karaoke mt-2 font-display text-lg tracking-widest" aria-hidden="true">
        {['KA', 'RA', 'O', 'KE'].map((s, i) => <span style={`--i:${i}`}>{s}</span>)}
      </p>
    )}
    {special.body && <p class="mt-2 text-sm font-medium">{localized(special.body, locale)}</p>}
  </div>
  <div class="mt-5 flex items-end justify-between gap-3">
    {special.cta !== 'none' ? (
      <a href={ctaHref} class="rounded-full bg-ink px-4 py-2 text-sm font-bold text-cream">{ctaText}</a>
    ) : <span />}
    {special.price !== null && (
      <span class="sticker bg-cream text-xl text-ink" style="--tilt:8deg">{formatPrice(special.price, locale)}</span>
    )}
  </div>
  {mascot && (
    <span class:list={['mascot pointer-events-none absolute text-4xl', special.id === 'flight' ? 'plane' : 'bob', special.image ? 'top-[22%] right-4' : 'top-4 right-4', live && 'hidden']} style={`--beat:${4 + (index % 3)}s; --tilt:${tilt * 3}deg`} aria-hidden="true">
      {mascot}
    </span>
  )}
  {special.id === 'unlimited-hookah' && (
    <span class="smoke pointer-events-none absolute right-8 bottom-24" aria-hidden="true"><span></span><span></span><span></span></span>
  )}
  {live && <span class="absolute top-3 right-3 sticker bg-hibiscus text-sm text-cream" style="--tilt:6deg">{t(locale, 'tonight.now')}</span>}
</article>
</div>

<style>
  .flyer {
    transform: rotate(var(--tilt));
    transition: transform 200ms ease;
  }
  .flyer:hover {
    transform: rotate(0deg) translateY(-4px);
  }
  .flyer img {
    transition: transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .flyer:hover img {
    transform: scale(1.06);
  }
  .mascot {
    filter: drop-shadow(2px 2px 0 rgb(0 0 0 / 0.35));
  }

  /* Karaoke: the bouncing ball hops from syllable to syllable. */
  .karaoke > span {
    position: relative;
    display: inline-block;
    margin-right: 0.35em;
    animation: lit 2.4s steps(1) infinite;
    animation-delay: calc(var(--i) * 0.6s);
    opacity: 0.45;
  }
  .karaoke > span::before {
    content: '';
    position: absolute;
    top: -0.55em;
    left: 50%;
    width: 0.4em;
    height: 0.4em;
    margin-left: -0.2em;
    border-radius: 999px;
    background: currentColor;
    opacity: 0;
    animation: hop 2.4s infinite;
    animation-delay: calc(var(--i) * 0.6s);
  }
  @keyframes lit {
    0% { opacity: 1; }
    25%, 100% { opacity: 0.45; }
  }
  @keyframes hop {
    0% { opacity: 1; transform: translateY(0); }
    12% { transform: translateY(-0.35em); }
    25% { opacity: 1; transform: translateY(0); }
    26%, 100% { opacity: 0; }
  }

  /* Hookah: smoke rings drift up and fade. */
  .smoke > span {
    position: absolute;
    width: 1.6rem;
    height: 0.7rem;
    border: 3px solid currentColor;
    border-radius: 999px;
    opacity: 0;
    animation: ringup 4.5s ease-out infinite;
  }
  .smoke > span:nth-child(2) { animation-delay: 1.5s; }
  .smoke > span:nth-child(3) { animation-delay: 3s; }
  @keyframes ringup {
    0% { opacity: 0; transform: translate(0, 0) scale(0.6); }
    20% { opacity: 0.7; }
    100% { opacity: 0; transform: translate(-1.5rem, -5rem) scale(1.6); }
  }

  /* The flight: a little plane crosses the flyer. */
  .plane {
    animation: fly 9s ease-in-out infinite;
  }
  @keyframes fly {
    0% { transform: translate(2rem, 1rem) rotate(-8deg); opacity: 0; }
    10% { opacity: 1; }
    50% { transform: translate(-6rem, -0.5rem) rotate(-14deg); }
    90% { opacity: 1; }
    100% { transform: translate(-14rem, -1.5rem) rotate(-8deg); opacity: 0; }
  }
</style>
