{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mezcalito",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },

  // Menu, nights, seasons, settings, orders and reservations.
  "d1_databases": [
    { "binding": "DB", "database_name": "mezcalito", "database_id": "d959a574-b8c0-4651-8995-ce2710a9c805", "migrations_dir": "migrations" }
  ],
  // Bumped on every staff save so edge-cached pages are rebuilt.
  "kv_namespaces": [{ "binding": "CACHE", "id": "2aace4b6d03f46f7914c64627643f7ba" }],
  // Photos, flyers, voice clips and music beds.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "mezcalito-media" }],
  "ai": { "binding": "AI" },
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "mezcalito_events" }],
  "durable_objects": {
    "bindings": [{ "name": "KITCHEN", "class_name": "KitchenRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KitchenRoom"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  // Orders, bookings, party requests and The Selector: 30 posts a minute per visitor.
  "ratelimits": [{ "name": "PUBLIC_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "vars": {
    // Empty: links use the address guests arrive on (workers.dev for now). Set it once a domain points here.
    "SITE_URL": "",
    "TIMEZONE": "America/Santo_Domingo"
  }
}
