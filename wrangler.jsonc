{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mezcalito",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },

  // Menu, nights, seasons, settings, orders and reservations.
  "d1_databases": [
    { "binding": "DB", "database_name": "mezcalito", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // Bumped on every staff save so edge-cached pages are rebuilt.
  "kv_namespaces": [{ "binding": "CACHE" }],
  // Photos, flyers, voice clips and music beds.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "mezcalito-media" }],
  "ai": { "binding": "AI" },
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "mezcalito_events" }],
  "durable_objects": {
    "bindings": [{ "name": "KITCHEN", "class_name": "KitchenRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KitchenRoom"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "SITE_URL": "https://mezcalitobarandgrill.com",
    "TIMEZONE": "America/Santo_Domingo"
  }
}
